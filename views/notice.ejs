<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Notices — Hill Academic Care</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('partials/header') %>
<main class="page">
  <section class="hero">
    <h1 data-en="Notices" data-bn="নোটিশসমূহ"></h1>
  </section>

  <section class="panel">
    <% if (notices.length === 0) { %>
      <p data-en="No notices have been published yet." data-bn="এখনও কোনো নোটিশ প্রকাশিত হয়নি।"></p>
    <% } else { %>
      <ul class="notice-list">
        <% notices.forEach(n => { %>
          <li>
            <a href="/notice/<%= n._id %>">
              <span data-en="<%= n.titleEn %>" data-bn="<%= n.titleBn %>"></span>
            </a>
            <span class="notice-date"><%= n.date %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
</body></html>
