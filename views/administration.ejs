<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Administration — Hill Academic Care</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/style.css?v=2">
<body>
<%- include('partials/header') %>
<main class="page">
  <section class="hero">
    <h1 data-en="Administration" data-bn="প্রশাসন"></h1>
  </section>

  <section class="panel">
    <h2 data-en="Rules &amp; Regulations" data-bn="নিয়মাবলী"></h2>
    <ul>
      <% content.rules.forEach(r => { %>
        <li data-en="<%= r.en %>" data-bn="<%= r.bn %>"></li>
      <% }) %>
    </ul>
  </section>

  <section class="panel">
    <h2 data-en="Class Time" data-bn="ক্লাসের সময়"></h2>
    <table>
      <tr>
        <th data-en="Class" data-bn="শ্রেণি"></th>
        <th data-en="Days" data-bn="দিন"></th>
        <th data-en="Time" data-bn="সময়"></th>
      </tr>
      <% content.classTimes.forEach(c => { %>
        <tr>
          <td data-en="<%= c.classEn %>" data-bn="<%= c.classBn %>"></td>
          <td data-en="<%= c.daysEn %>" data-bn="<%= c.daysBn %>"></td>
          <td><%= c.time %></td>
        </tr>
      <% }) %>
    </table>
    <p style="margin-top:14px;" data-en="<%= content.noteEn %>" data-bn="<%= content.noteBn %>"></p>
  </section>
</main>
<%- include('partials/footer') %>
</body></html>