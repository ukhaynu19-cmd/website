<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Site Admin — Dashboard</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { page: 'dashboard' }) %>
  <div class="admin-main">
    <h1>Dashboard</h1>
    <p style="color:var(--muted);margin-bottom:24px;">Manage the public website content here.</p>
    <div class="stat-grid">
      <div class="stat-card"><div class="label">Notices Published</div><div class="value"><%= noticeCount %></div></div>
      <div class="stat-card"><div class="label">Teachers Listed</div><div class="value"><%= teacherCount %></div></div>
      <div class="stat-card"><div class="label">New Applications</div><div class="value"><%= newApps %></div></div>
    </div>
  </div>
</div>
</body></html>
