<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Site Admin — Teachers</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { page: 'teachers' }) %>
  <div class="admin-main">
    <h1>Teachers</h1>

    <div class="panel">
      <h2>Add Teacher</h2>
      <form method="POST" action="/admin/teachers/add" enctype="multipart/form-data">
        <div class="form-row">
          <div class="field"><label>Full Name</label><input type="text" name="name" required></div>
          <div class="field"><label>Subject</label><input type="text" name="subject" required></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Designation (English)</label><input type="text" name="designationEn" placeholder="e.g. Senior Teacher" required></div>
          <div class="field"><label>Designation (Bangla)</label><input type="text" name="designationBn" placeholder="e.g. সিনিয়র শিক্ষক" required></div>
        </div>
        <div class="form-row">
  <div class="field"><label>Greeting Message (English)</label><textarea name="messageEn" placeholder="A short welcome message from this teacher..."></textarea></div>
  <div class="field"><label>Greeting Message (Bangla)</label><textarea name="messageBn" placeholder="শিক্ষকের পক্ষ থেকে সংক্ষিপ্ত বার্তা..."></textarea></div>
</div>
        <div class="form-row">
          <div class="field"><label>Photo</label><input type="file" name="photo" accept="image/*"></div>
        </div>
        <button type="submit" class="btn">Add Teacher</button>
      </form>
    </div>

    <div class="panel">
      <h2>All Teachers (<%= teachers.length %>)</h2>
      <% if (teachers.length === 0) { %>
        <p style="color:var(--muted);">No teachers added yet.</p>
      <% } else { %>
        <table>
          <tr><th>Photo</th><th>Name</th><th>Subject</th><th>Designation</th><th>Actions</th></tr>
          <% teachers.forEach(t => { %>
          <tr>
            <td>
              <% if (t.photoUrl) { %><img src="<%= t.photoUrl %>" style="width:40px;height:40px;border-radius:50%;object-fit:cover;">
              <% } else { %>—<% } %>
            </td>
            <td><%= t.name %></td>
            <td><%= t.subject %></td>
            <td><%= t.designationEn %></td>
            <td>
              <form method="POST" action="/admin/teachers/delete/<%= t._id %>" style="display:inline;" onsubmit="return confirm('Remove this teacher?');">
                <button type="submit" class="btn-small btn-danger">Delete</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </table>
      <% } %>
    </div>
  </div>
</div>
</body></html>
