<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Site Admin — Edit Teacher</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<div class="admin-shell">
  <%- include('../partials/admin-sidebar', { page: 'teachers' }) %>
  <div class="admin-main">
    <h1>Edit Teacher</h1>

    <div class="panel">
      <form method="POST" action="/admin/teachers/edit/<%= teacher._id %>" enctype="multipart/form-data">
        <div class="form-row">
          <div class="field"><label>Full Name</label><input type="text" name="name" value="<%= teacher.name %>" required></div>
          <div class="field"><label>Subject</label><input type="text" name="subject" value="<%= teacher.subject %>" required></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Designation (English)</label><input type="text" name="designationEn" value="<%= teacher.designationEn %>" required></div>
          <div class="field"><label>Designation (Bangla)</label><input type="text" name="designationBn" value="<%= teacher.designationBn %>" required></div>
        </div>
        <div class="form-row">
          <div class="field"><label>Greeting Message (English)</label><textarea name="messageEn"><%= teacher.messageEn %></textarea></div>
          <div class="field"><label>Greeting Message (Bangla)</label><textarea name="messageBn"><%= teacher.messageBn %></textarea></div>
        </div>
        <div class="form-row">
          <div class="field">
            <label>Photo</label>
            <% if (teacher.photoUrl) { %>
              <div style="margin-bottom:8px;"><img src="<%= teacher.photoUrl %>" style="width:60px;height:60px;border-radius:50%;object-fit:cover;"></div>
            <% } %>
            <input type="file" name="photo" accept="image/*">
            <small style="color:var(--muted);">Leave empty to keep the current photo.</small>
          </div>
        </div>
        <button type="submit" class="btn">Save Changes</button>
        <a href="/admin/teachers" class="btn-small" style="margin-left:8px;">Cancel</a>
      </form>
    </div>
  </div>
</div>
</body></html>