<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Admission — Hill Academic Care</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/style.css"></head>
<body>
<%- include('partials/header') %>
<main class="page">
  <section class="hero">
    <h1 data-en="Admission" data-bn="ভর্তি"></h1>
    <p data-en="Apply online — our team will contact you after reviewing your application." data-bn="অনলাইনে আবেদন করুন — আপনার আবেদন পর্যালোচনার পর আমাদের টিম আপনার সাথে যোগাযোগ করবে।"></p>
  </section>

  <section class="panel">
    <% if (submitted) { %>
      <div class="success-msg" data-en="Thank you! Your application has been received. We will contact you soon." data-bn="ধন্যবাদ! আপনার আবেদন গৃহীত হয়েছে। আমরা শীঘ্রই আপনার সাথে যোগাযোগ করব।"></div>
    <% } %>

    <form method="POST" action="/admission/apply">
      <div class="form-row">
        <div class="field">
          <label data-en="Student's Full Name" data-bn="শিক্ষার্থীর পূর্ণ নাম"></label>
          <input type="text" name="studentName" required>
        </div>
        <div class="field">
          <label data-en="Class Applying For" data-bn="যে শ্রেণিতে আবেদন করছেন"></label>
          <select name="className" required>
            <option value="Six">Six</option>
            <option value="Seven">Seven</option>
            <option value="Eight">Eight</option>
            <option value="Nine">Nine</option>
            <option value="Ten">Ten</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label data-en="Guardian's Name" data-bn="অভিভাবকের নাম"></label>
          <input type="text" name="guardianName" required>
        </div>
        <div class="field">
          <label data-en="Phone Number" data-bn="ফোন নম্বর"></label>
          <input type="tel" name="phone" required>
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label data-en="Email (optional)" data-bn="ইমেইল (ঐচ্ছিক)"></label>
          <input type="email" name="email">
        </div>
      </div>
      <div class="form-row">
        <div class="field">
          <label data-en="Message (optional)" data-bn="বার্তা (ঐচ্ছিক)"></label>
          <textarea name="message"></textarea>
        </div>
      </div>
      <button type="submit" class="btn" data-en="Submit Application" data-bn="আবেদন জমা দিন"></button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
</body></html>
