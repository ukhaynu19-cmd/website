<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>About Us — Hill Academic Care</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/css/style.css?v=2">
<body>
<%- include('partials/header') %>
<main class="page">
  <section class="hero">
    <h1 data-en="About Us" data-bn="আমাদের সম্পর্কে"></h1>
  </section>

  <section class="panel">
    <h2 data-en="Our Mission" data-bn="আমাদের লক্ষ্য"></h2>
    <p data-en="Hill Academic Care is dedicated to providing a nurturing and disciplined learning environment where every student can grow academically, morally, and socially. We believe education is the foundation for building responsible citizens and lifelong learners."
       data-bn="হিল একাডেমিক কেয়ার একটি যত্নশীল ও শৃঙ্খলাপূর্ণ শিক্ষার পরিবেশ প্রদানে প্রতিশ্রুতিবদ্ধ, যেখানে প্রতিটি শিক্ষার্থী একাডেমিক, নৈতিক ও সামাজিকভাবে বেড়ে উঠতে পারে। আমরা বিশ্বাস করি শিক্ষাই দায়িত্বশীল নাগরিক এবং আজীবন শিক্ষার্থী গড়ে তোলার ভিত্তি।"></p>
  </section>

  <section class="panel">
    <h2 data-en="Message from the Principal" data-bn="অধ্যক্ষের বাণী"></h2>
    <p data-en="It is my privilege to welcome you to Hill Academic Care. Our dedicated faculty and staff work tirelessly to ensure that every child receives quality education in a safe and supportive atmosphere. We look forward to partnering with families on this educational journey."
       data-bn="হিল একাডেমিক কেয়ারে আপনাকে স্বাগত জানাতে পেরে আমি সম্মানিত। আমাদের নিবেদিতপ্রাণ শিক্ষক ও কর্মীবৃন্দ নিরলসভাবে কাজ করেন যাতে প্রতিটি শিশু একটি নিরাপদ ও সহায়ক পরিবেশে মানসম্পন্ন শিক্ষা লাভ করে। এই শিক্ষাযাত্রায় পরিবারগুলোর সাথে অংশীদারিত্বের প্রত্যাশা রাখি।"></p>
  </section>

  <section class="panel">
    <h2 data-en="Campus" data-bn="ক্যাম্পাস"></h2>
    <p data-en="Our campus provides a safe, well-equipped environment including classrooms, a library, science facilities, and outdoor space for physical activities and events."
       data-bn="আমাদের ক্যাম্পাসে রয়েছে নিরাপদ ও সুসজ্জিত পরিবেশ, যার মধ্যে রয়েছে শ্রেণিকক্ষ, গ্রন্থাগার, বিজ্ঞান সুবিধা এবং শারীরিক কার্যক্রম ও অনুষ্ঠানের জন্য খোলা জায়গা।"></p>
  </section>
</main>
<%- include('partials/footer') %>
</body></html>
